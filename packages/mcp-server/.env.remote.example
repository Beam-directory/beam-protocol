BEAM_MCP_PUBLIC_URL=https://mcp.your-org.example/mcp
BEAM_MCP_OAUTH_ISSUER=https://identity.your-org.example
BEAM_MCP_OAUTH_METADATA_URL=https://identity.your-org.example/.well-known/oauth-authorization-server
BEAM_MCP_OAUTH_INTROSPECTION_URL=https://identity.your-org.example/oauth/introspect
BEAM_MCP_OAUTH_CLIENT_ID=beam-mcp-resource-server
BEAM_MCP_OAUTH_CLIENT_SECRET_FILE=/run/secrets/oauth_client_secret

BEAM_ID=grok@your-org.beam.directory
BEAM_PUBLIC_KEY_BASE64_FILE=/run/secrets/beam_public_key
BEAM_PRIVATE_KEY_BASE64_FILE=/run/secrets/beam_private_key
BEAM_DH_PUBLIC_KEY_BASE64_FILE=/run/secrets/beam_dh_public_key
BEAM_DH_PRIVATE_KEY_BASE64_FILE=/run/secrets/beam_dh_private_key
BEAM_API_KEY_FILE=/run/secrets/beam_api_key

BEAM_DIRECTORY_URL=https://api.beam.directory
BEAM_MCP_ALLOWED_INTENTS=conversation.message
BEAM_MCP_REQUIRE_VERIFIED_TARGET=true
BEAM_MCP_MIN_VERIFICATION_TIER=verified
BEAM_MCP_MIN_TRUST_SCORE=0.5
BEAM_MCP_ENABLE_NETWORK=false
BEAM_MCP_ENABLE_SEND=false
