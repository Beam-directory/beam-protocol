# Use an immutable registry digest in production, not a mutable tag.
BEAM_MCP_IMAGE=registry.example.com/beam-mcp@sha256:REPLACE_WITH_IMAGE_DIGEST
BEAM_MCP_PULL_POLICY=always
BEAM_MCP_BIND_PORT=3333

BEAM_MCP_PUBLIC_URL=https://mcp.your-org.example/mcp
BEAM_MCP_OAUTH_ISSUER=https://identity.your-org.example
BEAM_MCP_OAUTH_METADATA_URL=https://identity.your-org.example/.well-known/oauth-authorization-server
BEAM_MCP_OAUTH_INTROSPECTION_URL=https://identity.your-org.example/oauth/introspect
BEAM_MCP_OAUTH_CLIENT_ID=beam-mcp-resource-server

BEAM_ID=grok@your-org.beam.directory
BEAM_DIRECTORY_URL=https://api.beam.directory
BEAM_MCP_MIN_TRUST_SCORE=0.5
BEAM_MCP_ENABLE_NETWORK=false

# Absolute host paths. Store only one trimmed value in each mode-0600 file.
BEAM_MCP_OAUTH_CLIENT_SECRET_FILE=/secure/beam-mcp/oauth-client-secret
BEAM_PUBLIC_KEY_BASE64_FILE=/secure/beam-mcp/beam-public-key
BEAM_PRIVATE_KEY_BASE64_FILE=/secure/beam-mcp/beam-private-key
BEAM_API_KEY_FILE=/secure/beam-mcp/beam-api-key

# Usually empty. Add only exact extra hostnames required by the reverse proxy.
BEAM_MCP_ALLOWED_HOSTS=
BEAM_MCP_ALLOWED_ORIGIN_HOSTS=
